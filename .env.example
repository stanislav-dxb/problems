# Model calls default to the Claude Code CLI (llm.backend: claude_code in config.yaml): no API key needed,
# just a logged-in `claude`. Only set ANTHROPIC_API_KEY if you switch llm.backend to anthropic_api.
# ANTHROPIC_API_KEY=
# Only the sources below need credentials; HN and App Store work with none.

# --- Reddit (script app: https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=scout/0.1 by u/your_username

# --- Product Hunt (developer token: https://www.producthunt.com/v2/oauth/applications) ---
PRODUCTHUNT_TOKEN=

# --- YouTube Data API v3 (Google Cloud console, API key) ---
YOUTUBE_API_KEY=

# --- Optional: Telegram user account (https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=scout_telegram

# --- Optional: Adzuna job search (https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Scout settings ---
# Salt used when hashing author handles. Change once and keep it stable.
SCOUT_HASH_SALT=change-me
# Path to the SQLite database (default: ./scout.db)
SCOUT_DB=scout.db
# Path to config (default: ./config.yaml)
SCOUT_CONFIG=config.yaml
